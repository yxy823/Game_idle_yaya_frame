#!/bin/sh
# 框架仓库的提交后钩子：本次提交改了 Q&A 主题文件或渲染脚本时，重新生成 framework/qa/pages/ 下被忽略的 HTML 页面。
# 提交已经完成，生成失败只打印提示，不影响提交。说明见 framework/maintenance/tools/README.md 的「提交后生成 Q&A 页面」。
cd "$(git rev-parse --show-toplevel)" || exit 0

changed=$(git diff-tree --root --no-commit-id --name-only -r HEAD -- framework/qa/ project-source/skills/qa-explainer-godot/scripts/)
[ -n "$changed" ] || exit 0

node project-source/skills/qa-explainer-godot/scripts/qa-build.mjs framework/qa > /dev/null \
    || echo "Q&A 页面没有生成：在仓库根目录运行 node project-source/skills/qa-explainer-godot/scripts/qa-build.mjs framework/qa 查看错误。" >&2
exit 0
