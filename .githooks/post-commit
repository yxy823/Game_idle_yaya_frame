#!/bin/sh
# 框架仓库的提交后钩子：本次提交改了 Markdown 或框架全景的源码时，重新生成被忽略的 framework/panorama/dist/。
# 提交已经完成，生成失败只打印提示，不影响提交。说明见 framework/maintenance/tools/README.md 的「提交后生成框架全景」。
cd "$(git rev-parse --show-toplevel)" || exit 0

panorama=$(git diff-tree --root --no-commit-id --name-only -r HEAD -- '*.md' framework/panorama/)
if [ -n "$panorama" ]; then
    if [ -d framework/panorama/node_modules ]; then
        npm --prefix framework/panorama run build > /dev/null 2>&1 \
            || echo "框架全景没有生成：在仓库根目录运行 npm --prefix framework/panorama run build 查看错误。" >&2
    else
        echo "框架全景没有生成：还没安装依赖，在仓库根目录运行 npm --prefix framework/panorama install。" >&2
    fi
fi
exit 0
