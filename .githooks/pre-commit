#!/bin/sh
# 框架仓库的提交钩子：本次暂存了 Markdown 或 JSON 时，运行术语检查、措辞检查（只查硬性）、链接检查和链接文字检查；暂存了框架 Skill 时，检查两份 Skill 目录一致。
# 启用：git config core.hooksPath .githooks。说明见 framework/maintenance/tools/README.md 的「提交钩子」。
cd "$(git rev-parse --show-toplevel)" || exit 1
export PYTHONUTF8=1

# 新增、修改、改名后的文件交给术语与措辞检查；删除的文件也会让别处的链接失效，所以只用来决定是否运行链接检查。
changed=$(git diff --cached --name-only -z --diff-filter=ACMRD -- '*.md' '*.json' | tr '\0' '\n')
skills=$(git diff --cached --name-only -- .agents/skills .claude/skills)
[ -n "$changed" ] || [ -n "$skills" ] || exit 0
# 文件清单从标准输入传入，避免文件很多时超出命令行长度；路径里的中文和空格原样保留。
present=$(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md' '*.json' | tr '\0' '\n')

failed=""
# Codex 读 .agents/skills，Claude Code 读 .claude/skills，两份必须相同；比较的是暂存区中两个目录的树。
if [ -n "$skills" ]; then
    codex_tree=$(git write-tree --prefix=.agents/skills/ 2>/dev/null)
    claude_tree=$(git write-tree --prefix=.claude/skills/ 2>/dev/null)
    if [ -z "$codex_tree" ] || [ "$codex_tree" != "$claude_tree" ]; then
        echo "两份 Skill 目录不一致：.agents/skills 与 .claude/skills 的暂存内容不同。" >&2
        failed="$failed Skill 目录一致性检查"
    fi
fi
if [ -n "$present" ]; then
    python -B project-source/tools/checks/check-terminology.py --terms framework/terminology.md --files-from - <<EOF || failed="$failed 术语检查"
$present
EOF
    python -B project-source/tools/checks/check-wording.py --level hard --files-from - <<EOF || failed="$failed 措辞检查"
$present
EOF
fi
# 带 --check-link-text 时，失效链接也会让同一脚本失败；所以链接检查通过后再单独检查链接文字，两项失败分开报告。
if [ -n "$changed" ]; then
    if python -B framework/maintenance/tools/check_repository_links.py; then
        python -B framework/maintenance/tools/check_repository_links.py --check-link-text || failed="$failed 链接文字检查"
    else
        failed="$failed 仓库链接检查"
    fi
fi

if [ -n "$failed" ]; then
    echo "" >&2
    echo "提交被拒绝，未通过：$failed。" >&2
    echo "按上面列出的位置修改：不用的说法改为术语表中的正式名称；规则文件里的「应」「宜」「务必」按措辞检查给出的推荐写法改写；失效的链接改到存在的文件和标题；链接文字改为目标的章节标题或一级标题，文件说明写在链接外面。" >&2
    echo "Skill 目录不一致时，把改过的那份完整复制到另一份，例如改的是 .agents/skills 就在 PowerShell 运行 robocopy .agents\\skills .claude\\skills /MIR，再暂存两个目录。" >&2
    echo "改完后重新暂存（git add）再提交。检查的是工作区中的文件内容；命令找不到 python 时，先确认 python 在 PATH 中。" >&2
    exit 1
fi
exit 0
