{
  "capability_version": 2,
  "runtime": {"python": "3.13.16", "environment": "yaya-analyzer-2"},
  "modules": {"discovery": "features/*.py", "request_key": "modules", "default": "all applicable; basic analysis always runs"},
  "pool_memory_mib": 512,
  "sources": {
    "audio": {"extensions": ["wav", "ogg", "mp3", "flac"], "memory_mib": 384},
    "image": {"extensions": ["png", "jpg", "jpeg", "webp", "bmp", "tga", "tif", "tiff"], "memory_mib": 256}
  },
  "defaults": {
    "silence_dbfs": -50.0, "silence_min_seconds": 0.05,
    "series_points": 256, "palette_size": 8,
    "max_audio_samples": 8000000, "max_image_pixels": 8000000,
    "max_loudness_samples": 2000000
  },
  "limits": {
    "silence_dbfs": [-120, 0], "silence_min_seconds": [0.001, 10],
    "series_points": [16, 512], "palette_size": [1, 32],
    "max_audio_samples": [1, 8000000], "max_image_pixels": [1, 8000000],
    "max_loudness_samples": [1, 2000000]
  }
}
