#!/bin/sh
# 项目的提交钩子：本次暂存了 Markdown 或 JSON 时，运行术语检查、措辞检查（只查硬性）、链接检查和链接文字检查；
# 暂存了场景、资源、脚本、Shader 或素材时，运行资源格式检查，脚本另查 GDScript 文本；暂存了 Skill 时，检查两份 Skill 目录是否一致。
# 每次提交都运行引用检查和增量检查。
# 创建器已设置 core.hooksPath；重新 clone 后运行 git config core.hooksPath .githooks。说明见 yaya/tools/README.md 的「提交钩子」。
cd "$(git rev-parse --show-toplevel)" || exit 1
export PYTHONUTF8=1

# 本次新增、修改或改名的 Godot 文件，类型与 check-godot-resource-format.py 检查的一致。
staged_godot_files() {
    git diff --cached --name-only -z --diff-filter=ACMR -- '*.tscn' '*.tres' '*.gd' '*.gdshader' \
        '*.png' '*.jpg' '*.jpeg' '*.webp' '*.svg' '*.bmp' '*.tga' '*.wav' '*.ogg' '*.mp3' '*.ttf' '*.otf'
}

# 新增、修改、改名后的文件交给术语与措辞检查；删除的文件也会让别处的链接失效，所以也交给链接检查。
# --no-renames 把改名拆成删除和新增，旧路径也进清单，指向旧路径的链接才能被报出来。
changed=$(git diff --cached --name-only -z --no-renames --diff-filter=ACMD -- '*.md' '*.json' | tr '\0' '\n')
# 文件清单从标准输入传入，避免文件很多时超出命令行长度；路径里的中文和空格原样保留。
present=$(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md' '*.json' | tr '\0' '\n')
# 框架复制进来的文件按框架术语写，同步时会被覆盖，所以不交给项目术语检查。
project_owned=$(printf '%s\n' "$present" | grep -Ev '^(yaya/|addons/|\.agents/skills/|\.claude/skills/|\.claude/agents/|\.codex/agents/|AGENTS\.md$)')
godot=$(staged_godot_files | tr '\0' '\n')
skills=$(git diff --cached --name-only -- .agents/skills .claude/skills)
# 引用检查要知道删除和改名前的路径，因为别处指向它们的引用会失效。
all_staged=$(git -c core.quotepath=false diff --cached --name-only --no-renames)
[ -n "$all_staged" ] || exit 0

failed=""
# Codex 读 .agents/skills，Claude Code 读 .claude/skills，两份必须相同；比较的是暂存区中两个目录的树。
if [ -n "$skills" ]; then
    codex_tree=$(git write-tree --prefix=.agents/skills/ 2>/dev/null)
    claude_tree=$(git write-tree --prefix=.claude/skills/ 2>/dev/null)
    if [ -z "$codex_tree" ] || [ "$codex_tree" != "$claude_tree" ]; then
        echo "两份 Skill 目录不一致：.agents/skills 与 .claude/skills 的暂存内容不同。" >&2
        failed="$failed Skill 目录一致性检查"
    fi
fi
if [ -n "$project_owned" ]; then
    python -B yaya/tools/checks/check-terminology.py --files-from - <<EOF || failed="$failed 术语检查"
$project_owned
EOF
fi
if [ -n "$present" ]; then
    python -B yaya/tools/checks/check-wording.py --level hard --files-from - <<EOF || failed="$failed 措辞检查"
$present
EOF
fi
if [ -n "$changed" ]; then
    # 链接检查扫描整个项目，但只报本次暂存文件里的链接和指向它们的链接，
    # 所以同一目录里另一个任务没暂存的半成品不会挡住这次提交。
    python -B yaya/tools/checks/check-markdown-links.py --related-to - <<EOF || failed="$failed 链接检查"
$changed
EOF
    python -B yaya/tools/checks/check-link-text.py --related-to - <<EOF || failed="$failed 链接文字检查"
$changed
EOF
fi
# 资源格式检查只接受文件参数，xargs 按命令行长度分批运行；插件目录等默认范围外的文件由检查自己跳过。
if [ -n "$godot" ]; then
    staged_godot_files | xargs -0 python -B yaya/tools/checks/check-godot-resource-format.py || failed="$failed 资源格式检查"
    git diff --cached --name-only -z --diff-filter=ACMR -- '*.gd' \
        | xargs -0 -r python -B yaya/tools/checks/check-gdscript-text.py || failed="$failed GDScript 文本检查"
fi
python -B yaya/tools/checks/check-godot-references.py --related-to - <<EOF || failed="$failed 引用检查"
$all_staged
EOF
# 放宽检查和改 UID 只列出、不拒绝；新增编辑器信号连接才让它失败。
python -B yaya/tools/checks/check-staged-changes.py || failed="$failed 增量检查"

if [ -n "$failed" ]; then
    echo "" >&2
    echo "提交被拒绝，未通过：$failed。" >&2
    echo "按上面列出的位置修改：不用的说法改为 docs/terminology.md 中的正式名称；规则文件里的「应」「宜」「务必」按措辞检查给出的推荐写法改写；失效的链接改到存在的文件和标题；链接文字改为目标的章节标题或一级标题，文件说明写在链接外面。" >&2
    echo "资源格式检查列出的场景和资源用 yaya/tools/godot/resave_godot_files.gd 重存；缺 .uid 或 .import 时运行 yaya/tools/README.md「首次 Godot 扫描」的命令，把生成的文件一起暂存。" >&2
    echo "GDScript 文本、引用和增量检查的处理办法写在各自输出的最后一行，说明见 yaya/tools/README.md 中同名脚本的小节。" >&2
    echo "Skill 目录不一致时，把改过的那份完整复制到另一份，例如改的是 .agents/skills 就在 PowerShell 运行 robocopy .agents\\skills .claude\\skills /MIR，再暂存两个目录。" >&2
    echo "改完后重新暂存（git add）再提交。检查的是工作区中的文件内容；命令找不到 python 时，先确认 python 在 PATH 中。" >&2
    exit 1
fi
exit 0
