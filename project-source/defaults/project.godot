; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Godot Project"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

UiTheme="*res://game/shared/ui/ui_theme.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[gdunit4]

hooks/session_hooks=Dictionary[String, bool]({
"res://yaya/tools/testing/gdunit_diagnostic_session.gd": true
})
report/godot/push_error=true
report/godot/script_error=true
report/verbose_orphans=true
settings/test/flaky_check_enable=false
settings/test/test_lookup_folder="tests"

[gui]

theme/custom="res://game/shared/ui/project_theme.tres"
