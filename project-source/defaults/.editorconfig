root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 插件目录按原文件保留行尾空白，避免保存时产生无关差异
[addons/**]
trim_trailing_whitespace = false

[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
indent_size = 4
tab_width = 4

# 与随项目提供的工具和配置文件保持一致
[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
