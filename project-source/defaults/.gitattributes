# 自动识别文本并统一为 LF；二进制资源不做换行转换
* text=auto eol=lf

# 项目配置
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gdignore text eol=lf

# Godot 源码、文本场景/资源和导入元数据
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.glsl text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.gdextension text eol=lf
*.uid text eol=lf
*.import text eol=lf

# 项目工具与可读资源
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.gltf text eol=lf
*.obj text eol=lf
*.mtl text eol=lf

# 数据、文档和环境模板
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.csv text eol=lf
.env.example text eol=lf
*.env.example text eol=lf
.env.template text eol=lf
*.env.template text eol=lf

# Windows 命令脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 保留随项目提供的第三方原件，允许其已有的末尾空行
addons/gdscript-linter/docs/IGNORE_RULES.md whitespace=-blank-at-eof

# 固定版本的第三方插件含行尾空白，保留上游原件
addons/kanban_tasks/** whitespace=-blank-at-eol
addons/resources_spreadsheet_view/** whitespace=-blank-at-eol
addons/signal_lens/** whitespace=-blank-at-eol
addons/resources_spreadsheet_view/typed_editors/dock_texture.gd whitespace=-blank-at-eol,-blank-at-eof

# Godot 二进制场景/资源
*.scn binary
*.res binary
*.pck binary

# 图片、音视频、字体和二进制模型（仍由 Git 跟踪；未启用 LFS）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tga binary
*.exr binary
*.hdr binary
*.dds binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.mp4 binary
*.mov binary
*.webm binary
*.ogv binary
*.ttf binary
*.otf binary
*.glb binary
*.blend binary

# 文档、压缩包和本地扩展
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyc binary
*.pyd binary
