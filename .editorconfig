root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[framework/relationship-maps/*.readable.json]
indent_style = space
indent_size = 2
insert_final_newline = false

[*.{gd,gdshader}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf
